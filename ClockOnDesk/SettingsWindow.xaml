<Window x:Class="ClockOnDesk.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClockOnDesk"
        mc:Ignorable="d"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Title="Settings"
        Height="350"
        Width="300"
        Background="#121318">

    <Window.Resources>

        <!-- ============================== -->
        <!-- COMBOBOX ITEM -->
        <!-- ============================== -->

        <Style x:Key="NormalComboBoxItem"
               TargetType="ComboBoxItem">

            <Setter Property="Foreground"
                    Value="#F5F5F7"/>

            <Setter Property="Background"
                    Value="#252833"/>

            <Setter Property="Padding"
                    Value="8,5"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#303442"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#7C5CFC"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ============================== -->
        <!-- COLOR COMBOBOX ITEM -->
        <!-- ============================== -->

        <Style x:Key="ColorComboBoxItem"
               TargetType="ComboBoxItem">

            <Setter Property="Background"
                    Value="#252833"/>

            <Setter Property="Padding"
                    Value="8,5"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#303442"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ============================== -->
        <!-- COMBOBOX -->
        <!-- ============================== -->

        <Style x:Key="SettingsComboBox"
               TargetType="ComboBox">

            <Setter Property="Width"
                    Value="120"/>

            <Setter Property="Height"
                    Value="24"/>

            <Setter Property="FontSize"
                    Value="10"/>

            <Setter Property="Background"
                    Value="#252833"/>

            <Setter Property="Foreground"
                    Value="Black"/>

            <Setter Property="BorderBrush"
                    Value="#7C5CFC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

    </Window.Resources>


    <!-- ============================== -->
    <!-- ОСНОВНОЙ КОНТЕЙНЕР -->
    <!-- ============================== -->

    <Border Padding="20">

        <StackPanel>


            <!-- ============================== -->
            <!-- CLOCK FONT -->
            <!-- ============================== -->

            <Grid Margin="0,0,0,15">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="Clock Font"
                           Foreground="#F5F5F7"
                           FontSize="22"
                           FontStyle="Oblique"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>


                <ComboBox Grid.Column="1"
                          x:Name="FontComboBox"
                          Style="{StaticResource SettingsComboBox}"
                          HorizontalAlignment="Right"
                          SelectionChanged="FontComboBox_SelectionChanged">

                    <!-- Системные шрифты: Tag = просто имя шрифта -->

                    <ComboBoxItem Content="Arial"
                                  Tag="Arial"
                                  FontFamily="Arial"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="Calibri"
                                  Tag="Calibri"
                                  FontFamily="Calibri"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="Consolas"
                                  Tag="Consolas"
                                  FontFamily="Consolas"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="Times New Roman"
                                  Tag="Times New Roman"
                                  FontFamily="Times New Roman"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="Segoe UI"
                                  Tag="Segoe UI"
                                  FontFamily="Segoe UI"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <!--
                        Кастомные (встроенные) шрифты: Tag = "./Fonts/#Точное Внутреннее Имя".
                        ВАЖНО: имя после # должно СОВПАДАТЬ с реальным внутренним именем шрифта
                        (см. окно просмотра шрифта в проводнике Windows), а не с именем файла.
                        Ниже проставлено то, что подтверждено скриншотом (DotumChe).
                        Для KoblenzShadow и Gyrfalcon 3D / Motrhead Grotesk — проверьте и
                        подставьте настоящее внутреннее имя вместо плейсхолдера.
                    -->

                    <ComboBoxItem Content="KoblenzShadow"
                                  Tag="./Fonts/#KoblenzShadow"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="Gyrfalcon 3D"
                                  Tag="./Fonts/#Gyrfalcon 3D"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="DotumChe"
                                  Tag="./Fonts/#DotumChe RUS BY hidsky"
                                  FontFamily="./Fonts/#DotumChe RUS BY hidsky"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="Gilligan"
                                  Tag="./Fonts/#Gilligans Island"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="GarryMondrianCond4 BookSH"
                                  Tag="./Fonts/#GarryMondrianCond4"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                </ComboBox>

            </Grid>


            <!-- ============================== -->
            <!-- FONT SIZE -->
            <!-- ============================== -->

            <Grid Margin="0,0,0,15">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="Size Font"
                           Foreground="#F5F5F7"
                           FontSize="22"
                           FontStyle="Oblique"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>


                <ComboBox Grid.Column="1"
                          x:Name="FontComboBoxSize"
                          Style="{StaticResource SettingsComboBox}"
                          HorizontalAlignment="Right"
                          SelectionChanged="FontComboBox_SelectionChangeSize">

                    <ComboBoxItem Content="40"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="50"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="60"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="70"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="80"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="90"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="100"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="110"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="120"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="130"
                                  Style="{StaticResource NormalComboBoxItem}"/>

                    <ComboBoxItem Content="140"
                                  Style="{StaticResource NormalComboBoxItem}"/>
                    <ComboBoxItem Content="150"
                                  Style="{StaticResource NormalComboBoxItem}"/>
                </ComboBox>

            </Grid>


            <!-- ============================== -->
            <!-- FONT COLOR -->
            <!-- ============================== -->

            <Grid Margin="0,0,0,15">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="Font Color"
                           Foreground="#F5F5F7"
                           FontSize="22"
                           FontStyle="Oblique"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>


                <ComboBox Grid.Column="1"
                          x:Name="FontComboBoxColor"
                          Style="{StaticResource SettingsComboBox}"
                          HorizontalAlignment="Right"
                          SelectionChanged="FontComboBox_SelectionChangedColor">

                    <ComboBoxItem Content="Black"
                                  Foreground="Black"
                                  Style="{StaticResource ColorComboBoxItem}"/>

                    <ComboBoxItem Content="White"
                                  Foreground="White"
                                  Style="{StaticResource ColorComboBoxItem}"/>

                    <ComboBoxItem Content="Gray"
                                  Foreground="Gray"
                                  Style="{StaticResource ColorComboBoxItem}"/>

                    <ComboBoxItem Content="Red"
                                  Foreground="Red"
                                  Style="{StaticResource ColorComboBoxItem}"/>

                    <ComboBoxItem Content="Orange"
                                  Foreground="Orange"
                                  Style="{StaticResource ColorComboBoxItem}"/>

                    <ComboBoxItem Content="Purple"
                                  Foreground="Purple"
                                  Style="{StaticResource ColorComboBoxItem}"/>

                    <ComboBoxItem Content="HotPink"
                                  Foreground="HotPink"
                                  Style="{StaticResource ColorComboBoxItem}"/>

                    <ComboBoxItem Content="Pink"
                                  Foreground="Pink"
                                  Style="{StaticResource ColorComboBoxItem}"/>

                    <ComboBoxItem Content="Yellow"
                                  Foreground="Yellow"
                                  Style="{StaticResource ColorComboBoxItem}"/>

                    <ComboBoxItem Content="Green"
                                  Foreground="Green"
                                  Style="{StaticResource ColorComboBoxItem}"/>

                    <ComboBoxItem Content="Blue"
                                  Foreground="Blue"
                                  Style="{StaticResource ColorComboBoxItem}"/>

                    <ComboBoxItem Content="BlueViolet"
                                  Foreground="BlueViolet"
                                  Style="{StaticResource ColorComboBoxItem}"/>

                </ComboBox>

            </Grid>


            <!-- ============================== -->
            <!-- DATE CHECKBOX -->
            <!-- ============================== -->

            <CheckBox x:Name="CheckDate"
                      Content="Date Hide"
                      Foreground="White"
                      Margin="0,5,0,0"
                      HorizontalAlignment="Left"
                      Checked="CheckVox_Checked"
                      Unchecked="CheckBox_Unchecked"/>

        </StackPanel>

    </Border>

</Window>
