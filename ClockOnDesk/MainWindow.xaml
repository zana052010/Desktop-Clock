<Window x:Class="ClockOnDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClockOnDesk"
        mc:Ignorable="d"
        Title="Settings"
        Height="333"
        Width="373"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        Opacity="0.97"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid MouseLeftButtonDown="Window_MouseLeftButtonDown" Margin="0,10,10,-20" RenderTransformOrigin="0.504,0.479">



        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Top" Height="auto" Width="auto" Margin="0,36,0,0">

            <TextBlock
                Name="Time"
                Text="24:24"
                FontSize="60"
                Foreground="White"
                HorizontalAlignment="Center"
                IsHitTestVisible="False" Width="auto" Height="auto"/>

            <TextBlock
                Name="Date"
                Text="12.12.26"
                FontSize="30"
                Foreground="White"
                HorizontalAlignment="Center"
                IsHitTestVisible="False"
                Margin="0,5,0,0" Height="41"/>
            <Button
                Width="40"
                Height="40"
                BorderThickness="0"
                Background="Transparent"
                Click="Button_Click">

                <Image
                    Source="/Image/settings.png"
                    Width="20"
                    Height="20"
                    Opacity="0.5"/>

            </Button>

        </StackPanel>



    </Grid>
</Window>
