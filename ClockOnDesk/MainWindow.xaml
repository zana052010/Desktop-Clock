<Window x:Class="ClockOnDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClockOnDesk"
        mc:Ignorable="d"
        Title="Settings" Height="428" Width="634"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False"
        Opacity="0.97"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">



    <Grid Margin="0,0,10,0" Opacity="1" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <TextBlock
        Name="Time"
        HorizontalAlignment="Left"
        Margin="181,29,0,136"
        FontSize="60"
        Width="233"
        Foreground="White"
        IsHitTestVisible="False">
        </TextBlock>

        <TextBlock
        Name="Date"
        HorizontalAlignment="Left"
        Margin="181,124,0,28"
        FontSize="55"
        Foreground="White"
        IsHitTestVisible="False" 
        Width="443">
            0000
        </TextBlock>

        <Button
        Width="40"
        Height="40"
        BorderThickness="0"
        Background="Transparent"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Margin="0,79,97,0" 
        Click="Button_Click">
            <Image
            Source="/Image/settings.png"
            Width="34"
            Height="34" Opacity="0.5"/>

        </Button>
    </Grid>
</Window>
